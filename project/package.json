{
  "name": "ai-dev-tycoon",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:explore": "vite build --mode explore && tsx tools/verify-dist.ts dist-explore",
    "build:playtest": "vite build --mode playtest && tsx tools/verify-dist.ts dist-playtest",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "verify:dist": "tsx tools/verify-dist.ts",
    "check": "npm run typecheck && npm run lint && npm run assets:check && npm run test && npm run build && npm run verify:dist",
    "assets": "tsx tools/assets/index.ts",
    "assets:check": "tsx tools/assets/check.ts"
  },
  "dependencies": {
    "motion": "^14.6.0",
    "solid-js": "^1.9.17",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/three": "^0.186.0",
    "jsdom": "^30.1.3",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "svgo": "^4.1.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.5"
  }
}
